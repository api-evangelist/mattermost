                "name": "post_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a thread by post id"
        },
        {
          "info": {
            "name": "Pin a post",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{your-mattermost-server}/api/v4/posts/:post_id/pin",
            "params": [
              {
                "name": "post_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Pin a post"
        },
        {
          "info": {
            "name": "Unpin a post",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{your-mattermost-server}/api/v4/posts/:post_id/unpin",
            "params": [
              {
                "name": "post_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Unpin a post"
        },
        {
          "info": {
            "name": "Search posts in a team",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{your-mattermost-server}/api/v4/teams/:team_id/posts/search",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Search posts in a team"
        }
      ]
    }
  ],
  "bundled": true
}